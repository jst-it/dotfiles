#!/usr/bin/env bash
# Files each screen recording from a previous day into
# "Videos/Screen Recordings/<date>/", based on the date encoded in its
# filename (screenrecording-YYYY-MM-DD_...). Recordings from today are left
# in place so the compress/trim/keybind scripts - which look for the newest
# screenrecording-*.mp4 directly in the videos dir - keep working normally
# during the day; only once a file's date is in the past does it get filed
# away. Matches on the "screenrecording-" prefix generally, so trimmed/
# compressed derivatives (which keep that prefix) land in the same dated
# folder as their original.
#
# Once a dated folder's month is also in the past, it gets nested one level
# deeper into "Videos/Screen Recordings/<Month>_<Year>/<date>/". Current-month
# dated folders are left at the top level until their month ends.
#
# Runs once per login (see the matching systemd user service), but is safe
# to re-run any time - it just skips today's files, the current month's
# folders, and anything already organized.
set -uo pipefail

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
WATCH_DIR="${OMARCHY_SCREENRECORD_DIR:-${XDG_VIDEOS_DIR:-$HOME/Videos}}"
ORGANIZED_ROOT="$WATCH_DIR/Screen Recordings"
TODAY=$(date +%Y-%m-%d)

[[ -d "$WATCH_DIR" ]] || exit 0

shopt -s nullglob
for path in "$WATCH_DIR"/screenrecording-*; do
    [[ -f "$path" ]] || continue
    name=$(basename -- "$path")
    [[ "$name" =~ ^screenrecording-([0-9]{4}-[0-9]{2}-[0-9]{2}) ]] || continue
    date="${BASH_REMATCH[1]}"
    [[ "$date" == "$TODAY" ]] && continue

    dest_dir="$ORGANIZED_ROOT/$date"
    mkdir -p -- "$dest_dir"
    mv -n -- "$path" "$dest_dir/$name"
done

CURRENT_MONTH=$(date +%B_%Y)
for day_dir in "$ORGANIZED_ROOT"/*/; do
    day_dir="${day_dir%/}"
    day_name=$(basename -- "$day_dir")

    # Only bare YYYY-MM-DD dirs at the top level; a folder already nested
    # under a Month_Year dir doesn't match this glob, so it's never revisited.
    [[ "$day_name" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || continue

    folder_month=$(date -d "$day_name" +%B_%Y)
    [[ "$folder_month" == "$CURRENT_MONTH" ]] && continue

    dest_dir="$ORGANIZED_ROOT/$folder_month"
    mkdir -p -- "$dest_dir"
    mv -n -- "$day_dir" "$dest_dir/$day_name"
done
