#!/usr/bin/env bash
# Watch the sync folder and trigger a sync 30s after the last change settles.
set -uo pipefail

LOCAL="${PROTONDRIVE_LOCAL:-$HOME/Documents/School}"
DEBOUNCE="${PROTONDRIVE_DEBOUNCE:-30}"
DIRTY="$HOME/.local/state/protondrive-sync/dirty"

mkdir -p "$(dirname "$DIRTY")"

inotifywait -m -r -q \
  -e close_write -e create -e delete -e move \
  --exclude '(/\.git/|/\.cache/|~$|\.sw[px]$|\.tmp$|\.part$|^\..*\.rclone)' \
  "$LOCAL" |
while read -r _; do
  touch "$DIRTY"
  # Swallow the rest of the burst: keep reading until DEBOUNCE seconds of quiet.
  while read -r -t "$DEBOUNCE" _; do touch "$DIRTY"; done
  systemctl --user start protondrive-sync.service
done
